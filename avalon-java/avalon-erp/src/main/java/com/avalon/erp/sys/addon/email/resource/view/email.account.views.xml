<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="email_account_form_view" service="base.action.view">
        <field name="name">email account</field>
        <field name="label">邮件账号</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">email.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <el-button type="primary" size="small" action="testConnect" action-type="object">邮箱测试连接</el-button>
                </header>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="password"/>
                        </col>
                        <col>
                            <field name="userId"/>
                            <field name="emailServerId"/>
                        </col>
                    </row>
                </sheet>
            </form>
        </field>
    </record>
    <record id="email_account_tree_view" service="base.action.view">
        <field name="name">email account</field>
        <field name="label">邮件账号</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">email.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="password"/>
                <field name="emailServerId"/>
                <field name="userId"/>
            </tree>
        </field>
    </record>

    <record id="email_account_action" service="base.action.window">
        <field name="name">email account</field>
        <field name="label">邮件账号</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">email.account</field>
    </record>
</avalon>
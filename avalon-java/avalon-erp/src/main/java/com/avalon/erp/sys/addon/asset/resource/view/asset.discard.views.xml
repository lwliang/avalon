<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="asset_discard_view_form" service="base.action.view">
        <field name="name">asset discard view form</field>
        <field name="label">资产报废</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">asset.discard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="assetId"/>
                            <field name="discardDate"/>
                            <field name="remainValueValue"/>
                        </col>
                        <col>
                            <field name="responsibleUserId"/>
                            <field name="discardMethod"/>
                        </col>
                    </row>

                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_discard_view_tree" service="base.action.view">
        <field name="name">asset discard view tree</field>
        <field name="label">资产报废</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">asset.discard</field>
        <field name="arch" type="xml">
            <tree>
                <field name="assetId"/>
                <field name="discardDate"/>
                <field name="remainValueValue"/>
                <field name="responsibleUserId"/>
                <field name="remark"/>
                <field name="discardMethod"/>
            </tree>
        </field>
    </record>

    <record id="asset_discard_action" service="base.action.window">
        <field name="name">discard</field>
        <field name="label">资产报废</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">asset.discard</field>
    </record>
</avalon>
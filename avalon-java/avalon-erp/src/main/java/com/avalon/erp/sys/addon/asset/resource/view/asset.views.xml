<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="asset_asset_view_form" service="base.action.view">
        <field name="name">asset asset view form</field>
        <field name="label">资产</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">asset.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="categoryId"/>
                            <field name="purchaseDate"/>
                            <field name="purchaseValue"/>
                        </col>
                        <col>
                            <field name="currentValue"/>
                            <field name="depreciationRate"/>
                            <field name="depreciationMethod"/>
                        </col>
                    </row>
                    <row>
                        <col>
                            <field name="depreciationStartDate"/>
                            <field name="depreciationEndDate"/>
                            <field name="state"/>
                        </col>
                        <col>
                            <field name="responsibleUserId"/>
                            <field name="locationId"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_asset_view_tree" service="base.action.view">
        <field name="name">asset asset view tree</field>
        <field name="label">资产</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">asset.asset</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="categoryId"/>
                <field name="purchaseDate"/>
                <field name="purchaseValue"/>
                <field name="currentValue"/>
                <field name="depreciationRate"/>
                <field name="depreciationMethod"/>
                <field name="depreciationStartDate"/>
                <field name="depreciationEndDate"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="asset_asset_action" service="base.action.window">
        <field name="name">asset</field>
        <field name="label">资产</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">asset.asset</field>
    </record>
</avalon>
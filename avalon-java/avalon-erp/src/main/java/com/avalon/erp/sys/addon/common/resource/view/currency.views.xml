<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="common_currency_view_form" service="base.action.view">
        <field name="name">common_currency_view_form</field>
        <field name="label">币别表单</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">common.currency</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="symbol"/>
                        </col>
                        <col>
                            <field name="precision"/>
                            <field name="isActive"/>
                            <field name="isDefault"/>
                        </col>
                    </row>

                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="common_currency_view_tree" service="base.action.view">
        <field name="name">common_currency_view_tree</field>
        <field name="label">币别列表</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">common.currency</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="symbol"/>
                <field name="precision"/>
                <field name="isActive"/>
                <field name="isDefault"/>
            </tree>
        </field>
    </record>

    <record id="common_currency_action" service="base.action.window">
        <field name="name">currency</field>
        <field name="label">币别</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">common.currency</field>
    </record>
</avalon> 
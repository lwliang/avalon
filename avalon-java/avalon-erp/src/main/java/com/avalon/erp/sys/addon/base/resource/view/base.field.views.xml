<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="base_field_view_form" service="base.action.view">
        <field name="name">base_field_view_form</field>
        <field name="label">字段</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">base.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="serviceId"/>
                            <field name="sourceType"/>
                            <field name="name"/>
                            <field name="label"/>
                            <field name="type"/>
                            <field name="minValue"/>
                            <field name="maxValue"/>
                        </col>
                        <col>
                            <field name="isPrimaryKey"/>
                            <field name="isAutoIncrement"/>
                            <field name="isRequired"/>
                            <field name="isReadonly"/>
                            <field name="isUnique"/>
                            <field name="allowNull"/>
                            <field name="isMulti"/>
                        </col>
                    </row>
                    <row>
                        <col>
                            <field name="relativeServiceName"/>
                            <field name="relativeFieldName"/>
                        </col>
                        <col>
                            <field name="masterForeignKeyName"/>
                            <field name="relativeForeignKeyName"/>
                            <field name="manyServiceTable"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="默认值">
                            <field name="defaultValue"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_field_view_tree" service="base.action.view">
        <field name="name">base_field_view_tree</field>
        <field name="label">字段</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.field</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="sourceType"/>
                <field name="label"/>
                <field name="isPrimaryKey"/>
                <field name="isAutoIncrement"/>
                <field name="isRequired"/>
                <field name="isReadonly"/>
                <field name="type"/>
                <field name="serviceId"/>
                <field name="isUnique"/>
                <field name="allowNull"/>
                <field name="isMulti"/>
                <field name="isMulti"/>
                <field name="minValue"/>
                <field name="maxValue"/>
                <field name="relativeServiceName"/>
                <field name="relativeFieldName"/>
            </tree>
        </field>
    </record>

    <record id="base_field_action" service="base.action.window">
        <field name="name">user.field</field>
        <field name="label">字段</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.field</field>
    </record>
</avalon>
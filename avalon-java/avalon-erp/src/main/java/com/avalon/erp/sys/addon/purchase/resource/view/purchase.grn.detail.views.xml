<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="product_grn_detail_view_form" service="base.action.view">
        <field name="name">goods receipt note detail</field>
        <field name="label">收货单明细</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">purchase.goods.receipt.note.detail</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="orderDetailId"/>
                            <field name="receivableQuantity"/>
                            <field name="receivedQuantity"/>
                        </col>
                        <col>
                            <field name="unreceivedQuantity"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_grn_detail_view_tree" service="base.action.view">
        <field name="name">goods receipt note detail</field>
        <field name="label">收货单明细</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">purchase.goods.receipt.note.detail</field>
        <field name="arch" type="xml">
            <tree>
                <field name="orderDetailId"/>
                <field name="receivableQuantity"/>
                <field name="receivedQuantity"/>
                <field name="unreceivedQuantity"/>
                <field name="remark"/>
            </tree>
        </field>
    </record>
</avalon>
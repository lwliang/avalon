<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="stock_inventory_view_form" service="base.action.view">
        <field name="name">inventory</field>
        <field name="label">库存表</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">stock.inventory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="productId"/>
                            <field name="quantity"/>
                            <field name="reservedQuantity"/>
                            <field name="availableQuantity"/>
                        </col>
                        <col>
                            <field name="locationId"/>
                            <field name="unitId"/>
                            <field name="inventoryValue"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_inventory_view_tree" service="base.action.view">
        <field name="name">inventory</field>
        <field name="label">库存表</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">stock.inventory</field>
        <field name="arch" type="xml">
            <tree>
                <field name="productId"/>
                <field name="locationId"/>
                <field name="unitId"/>
                <field name="quantity"/>
                <field name="reservedQuantity"/>
                <field name="availableQuantity"/>
                <field name="inventoryValue"/>
            </tree>
        </field>
    </record>

    <record id="stock_inventory_action" service="base.action.window">
        <field name="name">inventory</field>
        <field name="label">库存表</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">stock.inventory</field>
    </record>
</avalon>
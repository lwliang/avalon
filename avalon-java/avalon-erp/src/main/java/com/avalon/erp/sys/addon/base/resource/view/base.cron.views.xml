<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="base_cron_view_form" service="base.action.view">
        <field name="name">base_cron_view_form</field>
        <field name="label">定时任务</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">base.cron</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="userId"/>
                        </col>
                        <col>
                            <field name="serviceId"/>
                            <field name="method"/>
                        </col>
                    </row>
                    <row>
                        <col>
                            <field name="cron"/>
                            <field name="status"/>
                        </col>
                        <col>
                            <field name="runNumber"/>
                            <field name="nextRunTime"/>
                            <field name="doAll"/>
                        </col>
                    </row>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_cron_view_tree" service="base.action.view">
        <field name="name">base_cron_view_tree</field>
        <field name="label">定时任务</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.cron</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="userId"/>
                <field name="serviceId"/>
                <field name="method"/>
                <field name="cron"/>
                <field name="status"/>
                <field name="runNumber"/>
                <field name="nextRunTime"/>
            </tree>
        </field>
    </record>

    <record id="base_cron_action" service="base.action.window">
        <field name="name">cron</field>
        <field name="label">定时任务</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.cron</field>
    </record>
</avalon>
<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="base_rule_view_form" service="base.action.view">
        <field name="name">base_rule_view_form</field>
        <field name="label">记录规则</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">base.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="serviceId"/>
                            <field name="active"/>
                            <field name="global"/>
                        </col>
                        <col>
                            <field name="permRead"/>
                            <field name="permWrite"/>
                            <field name="permCreate"/>
                            <field name="permUnlink"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="规则定义">
                            <field name="domainForce"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_rule_view_tree" service="base.action.view">
        <field name="name">base_rule_view_tree</field>
        <field name="label">记录规则</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="serviceId"/>
                <field name="domainForce"/>
                <field name="permRead"/>
                <field name="permWrite"/>
                <field name="permCreate"/>
                <field name="permUnlink"/>
                <field name="active"/>
                <field name="global"/>
            </tree>
        </field>
    </record>

    <record id="base_rule_action" service="base.action.window">
        <field name="name">base_rule_action</field>
        <field name="label">记录规则</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.rule</field>
    </record>
</avalon>
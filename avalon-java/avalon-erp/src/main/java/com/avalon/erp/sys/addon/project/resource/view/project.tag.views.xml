<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="project_tag_view_form" service="base.action.view">
        <field name="name">project tag view form</field>
        <field name="label">任务标签</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">project.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                        </col>
                        <col>
                            <field name="color"/>
                        </col>
                    </row>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_tag_view_tree" service="base.action.view">
        <field name="name">project tag view tree</field>
        <field name="label">任务标签</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">project.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="color"/>
            </tree>
        </field>
    </record>

    <record id="project_tag_action" service="base.action.window">
        <field name="name">tag</field>
        <field name="label">任务标签</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">project.tag</field>
    </record>
</avalon>
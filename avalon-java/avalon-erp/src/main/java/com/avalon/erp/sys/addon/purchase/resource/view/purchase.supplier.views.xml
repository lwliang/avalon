<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="product_supplier_view_form" service="base.action.view">
        <field name="name">supplier</field>
        <field name="label">供应商</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">purchase.supplier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="rank"/>
                            <field name="companyType"/>
                            <field name="type"/>
                        </col>
                        <col>
                            <field name="image"/>

                        </col>
                    </row>
                    <row>
                        <col>
                            <field name="provinceId"/>
                            <field name="cityId"/>
                            <field name="districtId"/>
                            <field name="street"/>
                        </col>
                        <col>
                            <field name="phone"/>
                            <field name="email"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="联系人">
                            <field name="childIds"/>
                        </page>
                        <page label="财务">
                            <row>
                                <col>
                                    <field name="vat"/>
                                </col>
                                <col>
                                    <field name="bankAccountNo"/>
                                </col>
                            </row>
                        </page>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_supplier_view_tree" service="base.action.view">
        <field name="name">supplier</field>
        <field name="label">供应商</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">purchase.supplier</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="image"/>
                <field name="rank"/>
                <field name="type"/>
                <field name="companyType"/>
                <field name="phone"/>
                <field name="vat"/>
                <field name="fullAddress"/>
            </tree>
        </field>
    </record>

    <record id="purchase_supplier_action" service="base.action.window">
        <field name="name">purchase supplier</field>
        <field name="label">供应商</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">purchase.supplier</field>
    </record>
</avalon>
<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="sale_customer_view_form" service="base.action.view">
        <field name="name">sale customer</field>
        <field name="label">客户</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">sale.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="partnerId.name"/>
                            <field name="rank"/>
                            <field name="companyType"/>
                            <field name="partnerId.type"/>
                        </col>
                        <col>
                            <field name="partnerId.image"/>
                        </col>
                    </row>
                    <row>
                        <col>
                            <field name="partnerId.provinceId"/>
                            <field name="partnerId.cityId"/>
                            <field name="partnerId.districtId"/>
                            <field name="partnerId.street"/>
                        </col>
                        <col>
                            <field name="partnerId.phone"/>
                            <field name="partnerId.email"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="备注">
                            <field name="partnerId.remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_customer_view_tree" service="base.action.view">
        <field name="name">customer</field>
        <field name="label">客户</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">sale.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partnerId.name"/>
                <field name="partnerId.image"/>
                <field name="rank"/>
                <field name="partnerId.type"/>
                <field name="companyType"/>
                <field name="partnerId.phone"/>
                <field name="partnerId.fullAddress"/>
            </tree>
        </field>
    </record>

    <record id="sale_customer_action" service="base.action.window">
        <field name="name">sale customer</field>
        <field name="label">客户</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">sale.customer</field>
    </record>
</avalon>
<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="hr_org_view_form" service="base.action.view">
        <field name="name">hr_org_view_form</field>
        <field name="label">组织表单</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">hr.org</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="parentId"/>
                        </col>
                        <col>
                            <field name="type"/>
                            <field name="chargeUserId"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="下级组织">
                            <field name="childIds"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_org_view_tree" service="base.action.view">
        <field name="name">hr_org_view_tree</field>
        <field name="label">组织</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">hr.org</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="chargeUserId"/>
                <field name="parentId"/>
            </tree>
        </field>
    </record>

    <record id="hr_org_action" service="base.action.window">
        <field name="name">org</field>
        <field name="label">组织</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">hr.org</field>
    </record>
</avalon>
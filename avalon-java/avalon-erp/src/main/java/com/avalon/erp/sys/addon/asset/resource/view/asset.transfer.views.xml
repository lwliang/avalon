<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="asset_transfer_view_form" service="base.action.view">
        <field name="name">asset transfer view form</field>
        <field name="label">资产转移</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">asset.transfer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="assetId"/>
                            <field name="fromLocationId"/>
                            <field name="toLocationId"/>
                        </col>
                        <col>
                            <field name="responsibleUserId"/>
                            <field name="transferDate"/>
                        </col>
                    </row>

                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_transfer_view_tree" service="base.action.view">
        <field name="name">asset transfer view tree</field>
        <field name="label">资产转移</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">asset.transfer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="assetId"/>
                <field name="fromLocationId"/>
                <field name="toLocationId"/>
                <field name="transferDate"/>
                <field name="responsibleUserId"/>
            </tree>
        </field>
    </record>

    <record id="asset_transfer_action" service="base.action.window">
        <field name="name">transfer</field>
        <field name="label">资产转移</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">asset.transfer</field>
    </record>
</avalon>
<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="base_group_view_form" service="base.action.view">
        <field name="name">base_group_view_form</field>
        <field name="label">权限组</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">base.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="description"/>
                        </col>
                        <col>
                            <field name="active"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="用户">
                            <field name="userIds"/>
                        </page>
                        <page label="规则">
                            <field name="ruleIds"/>
                        </page>
                        <page label="菜单">
                            <field name="menuIds"/>
                        </page>
                        <page label="模型">
                            <field name="serviceAccess"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_group_view_tree" service="base.action.view">
        <field name="name">base_group_view_tree</field>
        <field name="label">权限组</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="base_group_action" service="base.action.window">
        <field name="name">user.group</field>
        <field name="label">权限组</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.group</field>
    </record>
</avalon>
<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="product_rfq_view_form" service="base.action.view">
        <field name="name">request for quotation</field>
        <field name="label">询价单</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">purchase.request.for.quotation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="requestId"/>
                            <field name="productId"/>
                            <field name="unitId"/>
                            <field name="deadline"/>
                        </col>
                        <col>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="supplierId"/>
                            <field name="use"/>
                            <field name="remark"/>
                        </col>
                    </row>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_rfq_view_tree" service="base.action.view">
        <field name="name">request for quotation</field>
        <field name="label">询价单</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">purchase.request.for.quotation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="requestId"/>
                <field name="unitId"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="supplierId"/>
                <field name="deadline"/>
                <field name="remark"/>
                <field name="use"/>
            </tree>
        </field>
    </record>
</avalon>
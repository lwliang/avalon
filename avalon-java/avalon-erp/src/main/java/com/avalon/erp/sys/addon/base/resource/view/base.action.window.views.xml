<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="base_action_window_view_form" service="base.action.view">
        <field name="name">base_action_window_view_form</field>
        <field name="label">模型窗口</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">base.action.window</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="label"/>
                        </col>
                        <col>
                            <field name="serviceId"/>
                            <field name="viewMode"/>
                        </col>
                    </row>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_action_window_view_tree" service="base.action.view">
        <field name="name">base_action_window_view_tree</field>
        <field name="label">模型窗口</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.action.window</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="label"/>
                <field name="serviceId"/>
                <field name="viewMode"/>
            </tree>
        </field>
    </record>

    <record id="base_action_window_action" service="base.action.window">
        <field name="name">base.action.window</field>
        <field name="label">模型窗口</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.action.window</field>
    </record>
</avalon>
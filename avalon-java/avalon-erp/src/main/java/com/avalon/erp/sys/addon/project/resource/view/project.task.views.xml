<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="project_project_view_form" service="base.action.view">
        <field name="name">project project view form</field>
        <field name="label">项目</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">project.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="userId"/>
                            <field name="memberIds"/>
                            <field name="state"/>
                            <field name="progress"/>
                        </col>
                        <col>
                            <field name="startDate"/>
                            <field name="endDate"/>
                            <field name="plannedHours"/>
                            <field name="plannedHours"/>
                            <field name="totalHoursSpent"/>
                            <field name="color"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="项目任务">
                            <field name="taskIds"/>
                        </page>
                        <page label="项目描述">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_project_view_tree" service="base.action.view">
        <field name="name">project project view tree</field>
        <field name="label">项目</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">project.project</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="userId"/>
                <field name="startDate"/>
                <field name="endDate"/>
                <field name="plannedHours"/>
                <field name="totalHoursSpent"/>
                <field name="color"/>
                <field name="progress"/>
                <field name="state"/>
                <field name="memberIds"/>
            </tree>
        </field>
    </record>

    <record id="project_project_action" service="base.action.window">
        <field name="name">project</field>
        <field name="label">项目</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">project.project</field>
    </record>
</avalon>
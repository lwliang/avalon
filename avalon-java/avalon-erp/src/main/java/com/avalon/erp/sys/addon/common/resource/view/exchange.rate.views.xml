<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="common_exchange_rate_view_form" service="base.action.view">
        <field name="name">common_exchange_rate_view_form</field>
        <field name="label">汇率表单</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">common.exchange.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="fromCurrencyId"/>
                            <field name="toCurrencyId"/>
                        </col>
                        <col>
                            <field name="rate"/>
                            <field name="effectiveDate"/>
                            <field name="isActive"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="common_exchange_rate_view_tree" service="base.action.view">
        <field name="name">common_exchange_rate_view_tree</field>
        <field name="label">汇率列表</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">common.exchange.rate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="fromCurrencyId"/>
                <field name="toCurrencyId"/>
                <field name="rate"/>
                <field name="effectiveDate"/>
                <field name="isActive"/>
            </tree>
        </field>
    </record>

    <record id="common_exchange_rate_action" service="base.action.window">
        <field name="name">exchange rate</field>
        <field name="label">汇率</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">common.exchange.rate</field>
    </record>
</avalon> 
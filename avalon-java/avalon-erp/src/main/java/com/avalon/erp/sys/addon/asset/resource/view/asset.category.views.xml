<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="asset_category_view_form" service="base.action.view">
        <field name="name">asset category view form</field>
        <field name="label">资产类别</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">asset.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                        </col>
                        <col>
                            <field name="code"/>
                        </col>
                    </row>

                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_category_view_tree" service="base.action.view">
        <field name="name">asset category view tree</field>
        <field name="label">资产类别</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">asset.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="asset_category_action" service="base.action.window">
        <field name="name">category</field>
        <field name="label">资产类别</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">asset.category</field>
    </record>
</avalon>
<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="product_request_view_form" service="base.action.view">
        <field name="name">request</field>
        <field name="label">采购申请单</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="requestDate"/>
                            <field name="userId"/>
                            <field name="productId"/>
                        </col>
                        <col>
                            <field name="status"/>
                            <field name="unitId"/>
                            <field name="quantity"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="询价单">
                            <field name="rfqIds"/>
                        </page>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_request_view_tree" service="base.action.view">
        <field name="name">request</field>
        <field name="label">采购申请单</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">purchase.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="requestDate"/>
                <field name="userId"/>
                <field name="productId"/>
                <field name="unitId"/>
                <field name="quantity"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="purchase_request_action" service="base.action.window">
        <field name="name">purchase request</field>
        <field name="label">采购申请单</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">purchase.request</field>
    </record>
</avalon>
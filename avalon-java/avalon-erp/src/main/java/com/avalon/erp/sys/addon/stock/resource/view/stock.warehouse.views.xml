<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="stock_warehouse_view_form" service="base.action.view">
        <field name="name">warehouse</field>
        <field name="label">仓库</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">stock.warehouse</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="provinceId"/>
                            <field name="cityId"/>
                        </col>
                        <col>
                            <field name="code"/>
                            <field name="districtId"/>
                            <field name="street"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_warehouse_view_tree" service="base.action.view">
        <field name="name">warehouse</field>
        <field name="label">仓库</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">stock.warehouse</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="fullAddress"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="stock_warehouse_action" service="base.action.window">
        <field name="name">warehouse</field>
        <field name="label">仓库</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">stock.warehouse</field>
    </record>
</avalon>
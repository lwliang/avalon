<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="base_service_view_form" service="base.action.view">
        <field name="name">base_service_view_form</field>
        <field name="label">模型</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">base.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="moduleId"/>
                            <field name="name"/>
                            <field name="label"/>
                        </col>
                        <col>
                            <field name="nameField"/>
                            <field name="keyField"/>
                            <field name="tableName"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="字段">
                            <field name="fields"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_service_view_tree" service="base.action.view">
        <field name="name">base_service_view_tree</field>
        <field name="label">模型</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="label"/>
                <field name="tableName"/>
                <field name="moduleId"/>
                <field name="nameField"/>
                <field name="keyField"/>
            </tree>
        </field>
    </record>

    <record id="base_service_action" service="base.action.window">
        <field name="name">base.service</field>
        <field name="label">模型</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">base.service</field>
    </record>
</avalon>
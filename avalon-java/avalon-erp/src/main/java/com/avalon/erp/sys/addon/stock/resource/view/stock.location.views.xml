<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="stock_location_view_form" service="base.action.view">
        <field name="name">location</field>
        <field name="label">库位</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">stock.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="completeName" readonly="true"/>
                            <field name="capacity"/>
                        </col>
                        <col>
                            <field name="parentId"/>
                            <field name="active"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_location_view_tree" service="base.action.view">
        <field name="name">location</field>
        <field name="label">库位</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">stock.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="completeName"/>
                <field name="warehouseId"/>
                <field name="capacity"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="stock_location_action" service="base.action.window">
        <field name="name">location</field>
        <field name="label">库位</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">stock.location</field>
    </record>
</avalon>
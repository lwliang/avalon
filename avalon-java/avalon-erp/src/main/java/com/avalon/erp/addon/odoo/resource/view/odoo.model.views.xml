<?xml version="1.0" encoding="UTF-8"?>
<avalon>
    <record id="odoo_model_view_form" service="base.action.view">
        <field name="name">odoo_model_view_form</field>
        <field name="label">Odoo 模型</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">odoo.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="originalName"/>
                            <field name="name"/>
                        </col>
                        <col>
                            <field name="label"/>
                            <field name="module"/>
                        </col>
                    </row>
                    
                </sheet>
            </form>
        </field>
    </record>

    <record id="odoo_model_view_tree" service="base.action.view">
        <field name="name">odoo_model_view_tree</field>
        <field name="label">Odoo 模型</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">odoo.model</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="originalName"/>
                <field name="name"/>
                <field name="label"/>
                <field name="module"/>
            </tree>
        </field>
    </record>
</avalon>
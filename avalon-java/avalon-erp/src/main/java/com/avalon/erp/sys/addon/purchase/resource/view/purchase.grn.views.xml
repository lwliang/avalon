<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="product_grn_view_form" service="base.action.view">
        <field name="name">goods receipt note</field>
        <field name="label">收货单</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">purchase.goods.receipt.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="orderId"/>
                            <field name="receiptDate"/>
                        </col>
                        <col>
                            <field name="userId"/>
                            <field name="status"/>
                            <field name="totalAmount"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="收货明细">
                            <field name="detailIds"/>
                        </page>
                        <page label="备注">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_grn_view_tree" service="base.action.view">
        <field name="name">goods receipt note</field>
        <field name="label">收货单</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">purchase.goods.receipt.note</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="userId"/>
                <field name="orderId"/>
                <field name="receiptDate"/>
                <field name="totalQuantity"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="purchase_grn_action" service="base.action.window">
        <field name="name">goods receipt note</field>
        <field name="label">收货单</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">purchase.goods.receipt.note</field>
    </record>
</avalon>
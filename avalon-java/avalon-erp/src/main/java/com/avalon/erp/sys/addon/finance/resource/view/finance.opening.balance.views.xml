<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="finance_opening_balance_view_form" service="base.action.view">
        <field name="name">finance_opening_balance_view_form</field>
        <field name="label">期初余额表单</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">finance.opening.balance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="accountSetId"/>
                            <field name="accountId"/>
                            
                        </col>
                        <col>
                            <field name="periodStartDate"/>
                            <field name="debitAmount"/>
                            <field name="creditAmount"/>
                        </col>
                    </row>
                    
                    <notebook>
                        <page label="备注">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="finance_opening_balance_view_tree" service="base.action.view">
        <field name="name">finance_opening_balance_view_tree</field>
        <field name="label">期初余额列表</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">finance.opening.balance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="accountSetId"/>
                <field name="accountId"/>
                <field name="periodStartDate"/>
                <field name="debitAmount"/>
                <field name="creditAmount"/>
            </tree>
        </field>
    </record>

    <record id="finance_opening_balance_action" service="base.action.window">
        <field name="name">finance_opening_balance</field>
        <field name="label">期初余额</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">finance.opening.balance</field>
    </record>
</avalon> 
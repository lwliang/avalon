<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="product_product_view_form" service="base.action.view">
        <field name="name">product</field>
        <field name="label">产品</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">product.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="unitId"/>
                            <field name="productType"/>
                        </col>
                        <col>
                            <field name="image"/>
                        </col>
                    </row>
                    <notebook>
                        <page label="描述">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_product_view_tree" service="base.action.view">
        <field name="name">product</field>
        <field name="label">产品</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">product.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="image"/>
                <field name="unitId"/>
                <field name="productType"/>
            </tree>
        </field>
    </record>

    <record id="product_product_action" service="base.action.window">
        <field name="name">product</field>
        <field name="label">产品</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">product.product</field>
    </record>
</avalon>
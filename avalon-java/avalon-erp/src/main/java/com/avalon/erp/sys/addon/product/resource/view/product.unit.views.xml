<?xml version="1.0" encoding="UTF-8" ?>
<avalon>
    <record id="product_unit_view_form" service="base.action.view">
        <field name="name">product_unit_view_form</field>
        <field name="label">单位</field>
        <field name="viewMode">form</field>
        <field name="ref_serviceId">product.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <row>
                        <col>
                            <field name="name"/>
                        </col>
                        <col>
                            <field name="label"/>
                        </col>
                    </row>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_unit_view_tree" service="base.action.view">
        <field name="name">unit</field>
        <field name="label">单位</field>
        <field name="viewMode">tree</field>
        <field name="ref_serviceId">product.unit</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="label"/>
            </tree>
        </field>
    </record>

</avalon>